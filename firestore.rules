rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Imóveis: leitura pública só do que está publicado; rascunhos só
    // ficam visíveis pra quem tem a custom claim de admin (Cauan/Toninho
    // — concedida via `npm run set-admin-claims`, ver ARQUITETURA.md).
    // Não basta `request.auth != null`: com login por conta do Google
    // liberado pra qualquer pessoa, isso deixaria qualquer conta do
    // Google ler rascunho. Escrita continua só via Admin SDK (funções
    // serverless em api/).
    match /imoveis/{docId} {
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.token.admin == true);
      allow write: if false;
    }

    // Contador do código sequencial do imóvel (TB-0001, TB-0002...) — só
    // lido/escrito pelo Admin SDK, nunca pelo cliente.
    match /_meta/{docId} {
      allow read, write: if false;
    }

    // Rastreio anônimo de comportamento (cliques em imóvel, buscas,
    // visitas de página) — ver src/lib/analytics.ts. Qualquer visitante
    // pode criar um evento (sem estar logado — é assim que se rastreia
    // quem NÃO é o corretor), mas só no formato esperado; ninguém lê,
    // edita ou apaga um evento já gravado, exceto quem tem a claim de
    // admin, que só lê (painel de estatísticas em /admin/estatisticas).
    match /analytics_events/{eventId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.type in ['page_view', 'property_view', 'search', 'whatsapp_click']
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 100
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
