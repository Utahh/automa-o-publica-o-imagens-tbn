# Copie este arquivo para ".env.local" (já é ignorado pelo git).

# Servidor — Dashboard do Cloudinary (https://cloudinary.com/console).
# Usado pelas funções em api/ (deletar assets) e por scripts locais.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servidor — e-mails com acesso ao painel de cadastro (/admin),
# separados por vírgula. Ex: cauan@exemplo.com,toninho@exemplo.com
ALLOWED_ADMIN_EMAILS=

# Cliente (VITE_*) — não são segredo: é assim que o upload unsigned do
# Cloudinary funciona (o navegador sobe a foto/vídeo direto, sem passar
# pela API secret). Preset criado no Dashboard do Cloudinary > Settings >
# Upload > Upload presets (modo "Unsigned").
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
